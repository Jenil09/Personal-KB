# Copy to .env and fill in. Never commit .env.

# --- kb-api ---------------------------------------------------------------
KB_API__ENV=local
KB_API__LOG_LEVEL=INFO

# Comma-separated <key_id>:<secret> pairs. key_id is recorded on every audit row.
KB_API__API_KEYS=local-dev:change-me,n8n:change-me-too,kb-mcp:change-me

# What each key may do (AD-024): <key_id>:<scope>|<scope>. Two scopes exist —
# `search` covers search and the document reads, `write` covers ingest, delete,
# and admin stats.
#
# A key NOT named here gets every scope. That is the permissive direction, so
# the n8n key must be listed: it is held by a workflow that processes scraped,
# untrusted content, and `search` alone is what stops a prompt injection that
# reaches it from purging the corpus. The resolved grants are logged at startup.
KB_API__API_KEY_SCOPES=n8n:search,local-dev:search|write,kb-mcp:search|write

# --- rate limiting (AD-014) -----------------------------------------------
# Defaults shown; all optional. Only the first and third reject — the daily
# anomaly flags the audit row and serves the request, because the gap between
# normal traffic and a legitimately busy day is wide enough that a limit set
# near normal would eventually refuse real work.
# KB_API__RATE_LIMITS__PER_MINUTE=60
# KB_API__RATE_LIMITS__DAILY_ANOMALY=600
# KB_API__RATE_LIMITS__DAILY_LIMIT=2000
# KB_API__RATE_LIMITS__REPEAT_BURST_COUNT=5
# KB_API__RATE_LIMITS__REPEAT_BURST_WINDOW_SECONDS=300

# --- datastores (match compose.dev.yml) -----------------------------------
KB_API__POSTGRES__DSN=postgresql+asyncpg://kb:kb_local_dev@localhost:5433/kb
KB_API__CHROMA__HOST=localhost
KB_API__CHROMA__PORT=8001

# --- embedding providers --------------------------------------------------
# A provider is configured by having a key, and only configured providers are
# offered. Leave the block out entirely rather than blank: an empty value is
# rejected at startup, because a half-configured provider fails on the first
# embedding call instead of on boot.
KB_API__OPENAI__API_KEY=sk-...
# KB_API__GEMINI__API_KEY=

# `libs/ai-embeddings` tests against the live API on OPENAI_API_KEY, the name the
# SDK itself uses. It is a separate variable on purpose: the library has no
# opinion about which service mounts it, and a library test reaching for a
# `KB_API__` prefix would tie it to one. Set both to the same value if you want
# `just test-int` to run the token-accounting check (it costs well under a cent);
# leave this one out and those eight tests skip.
# OPENAI_API_KEY=sk-...

# Which collection an ingest or search targets when the body names no provider.
KB_API__DEFAULT_PROVIDER=openai

# --- request limits -------------------------------------------------------
# Technical Design §8. AD-023 removed the reverse proxy that used to cap bodies
# ahead of the app, so this is the only cap there is.
KB_API__MAX_BODY_BYTES=10485760

# --- search (AD-008, AD-021) ----------------------------------------------
# The query-embedding cache is in-process and dies with the worker. Design §8
# measured its hit rate as near zero for the n8n workload — it is kept because
# it costs nothing idle, not as a latency optimisation. Zero disables it.
KB_API__QUERY_CACHE_SIZE=512
KB_API__QUERY_CACHE_TTL_SECONDS=900
# How many document IDs a tag filter may put in Chroma's `$in` clause (AD-005).
KB_API__TAG_FILTER_LIMIT=2000

# --- audit (AD-013) -------------------------------------------------------
KB_API__AUDIT__SPILL_PATH=./data/audit.spill.jsonl

# --- kb-mcp ---------------------------------------------------------------
# A third consumer of kb-api (AD-025): streamable HTTP to an LLM host, HTTP
# client of this service. Two credentials, never one string — the token a host
# presents here is not the key this process presents to kb-api.
#
# Secrets are commented rather than blank. A blank `KB_MCP__…API_KEY=` is
# rejected at startup (Phase 6); leaving the line out is the form that means
# "not configured on this machine".
#
# KB_MCP__API_KEYS=claude:change-me
# KB_MCP__API_KEY_SCOPES=claude:search|write
# KB_MCP__KB_API__API_KEY=change-me
# KB_MCP__KB_API__BASE_URL=http://localhost:8000

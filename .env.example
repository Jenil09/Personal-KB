# Copy to .env and fill in. Never commit .env.

# --- kb-api ---------------------------------------------------------------
KB_API__ENV=local
KB_API__LOG_LEVEL=INFO

# Comma-separated <key_id>:<secret> pairs. key_id is recorded on every audit row.
KB_API__API_KEYS=local-dev:change-me

# --- datastores (match compose.dev.yml) -----------------------------------
KB_API__POSTGRES__DSN=postgresql+asyncpg://kb:kb_local_dev@localhost:5433/kb
KB_API__CHROMA__HOST=localhost
KB_API__CHROMA__PORT=8001

# --- embedding providers --------------------------------------------------
# A provider is configured by having a key, and only configured providers are
# offered. Leave the block out entirely rather than blank: an empty value is
# rejected at startup, because a half-configured provider fails on the first
# embedding call instead of on boot.
KB_API__OPENAI__API_KEY=sk-...
# KB_API__GEMINI__API_KEY=

# Which collection an ingest or search targets when the body names no provider.
KB_API__DEFAULT_PROVIDER=openai

# --- request limits -------------------------------------------------------
# Technical Design §8. Nginx caps bodies too; this one holds without it.
KB_API__MAX_BODY_BYTES=10485760

# --- audit (AD-013) -------------------------------------------------------
KB_API__AUDIT__SPILL_PATH=./data/audit.spill.jsonl

# --- rate limiting (AD-014) -----------------------------------------------
KB_API__LIMITS__PER_MINUTE=60
KB_API__LIMITS__PER_DAY_ANOMALY=600
KB_API__LIMITS__PER_DAY_HARD=2000
KB_API__LIMITS__REPEAT_COUNT=5
KB_API__LIMITS__REPEAT_WINDOW_SECONDS=300

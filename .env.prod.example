# Copy to `.env.prod` on the VPS and fill in. Never commit `.env.prod`.
#
#     cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# This one file serves two purposes, which is why every compose command in
# docs/DEPLOYMENT.md passes `--env-file .env.prod`: compose interpolates `${…}`
# in `compose.prod.yml` from it, and injects it into `kb-api`, `kb-mcp`, and
# `migrate` as container environment. Omit the flag and the Postgres credentials
# resolve to empty strings.
#
# The `KB_…` names below are compose's; the `KB_API__…` names are the service's
# (kb_api/config.py). Both live here because both come from the same file.

# --- image ----------------------------------------------------------------
# Whatever `just image` / `just image-mcp` tagged, or a registry reference if
# you push one.
KB_API_IMAGE=kb-api:latest
KB_MCP_IMAGE=kb-mcp:latest

# --- Postgres -------------------------------------------------------------
# The audit schema holds full search query text (AD-013), so this database
# carries the same sensitivity as the knowledge base itself: same access
# control, same backup treatment.
KB_POSTGRES_USER=kb
KB_POSTGRES_PASSWORD=
KB_POSTGRES_DB=kb

# The service's own view of the same database. `postgres` is the container name
# on `kb-internal`; the port is the container's, not a published one.
KB_API__POSTGRES__DSN=postgresql+asyncpg://kb:CHANGE_ME@postgres:5432/kb

# --- API keys (AD-011, AD-024) --------------------------------------------
# Comma-separated <key_id>:<secret>. key_id lands on every audit row.
KB_API__API_KEYS=n8n:CHANGE_ME,operator:CHANGE_ME,kb-mcp:CHANGE_ME

# A key NOT named here gets every scope, so the n8n key must be listed. It is
# held by a workflow that processes scraped, untrusted content, and `search`
# alone is what stops a prompt injection reaching it from purging the corpus.
# `create_app` logs the resolved grants at startup — read them after a deploy.
KB_API__API_KEY_SCOPES=n8n:search,operator:search|write,kb-mcp:search|write

# --- embedding provider ---------------------------------------------------
# A provider is configured by having a key, and only configured providers are
# offered. Leave a block out entirely rather than blank — an empty value is
# rejected at startup rather than at the first embedding call.
KB_API__OPENAI__API_KEY=
# KB_API__GEMINI__API_KEY=
KB_API__DEFAULT_PROVIDER=openai

# --- Tailscale (AD-023) ---------------------------------------------------
# The operator entry point. A reusable, non-ephemeral auth key, or an OAuth
# client secret — an ephemeral key means the node disappears on restart and the
# `production` Bruno environment stops resolving.
KB_TAILSCALE_AUTHKEY=
KB_TAILSCALE_HOSTNAME=kb-api
# `--advertise-tags=tag:kb-api` belongs here if the tailnet ACL defines that
# tag, and breaks authentication if it does not. Empty is the safe default.
KB_TAILSCALE_EXTRA_ARGS=

# --- kb-mcp ---------------------------------------------------------------
# Inbound tokens an MCP host presents to this server, and the key this process
# presents to kb-api. The two are different credentials; the outbound one must
# match the `kb-mcp` entry in KB_API__API_KEYS above so tool calls land on
# that key_id in the tier-1 trail.
#
# Secrets are omitted rather than blank — a half-configured `API_KEY=` is
# rejected at startup (Phase 6).
# KB_MCP__API_KEYS=claude:CHANGE_ME
# KB_MCP__API_KEY_SCOPES=claude:search|write
# KB_MCP__KB_API__API_KEY=CHANGE_ME
#
# Compose also sets BASE_URL to http://kb-api:8000 in the service's
# `environment:`, so a missing line here cannot silently point at localhost.
KB_MCP__KB_API__BASE_URL=http://kb-api:8000
# The tailnet URL `tailscale serve` publishes on :8443. Unset suppresses the
# RFC 9728 advertisement, which is right locally and wrong here: a host that
# follows the metadata should fail somewhere diagnosable.
KB_MCP__RESOURCE_SERVER_URL=https://kb-api.CHANGE_ME.ts.net:8443

# --- optional overrides ---------------------------------------------------
# Defaults are the numbers AD-014 argued for; they are configurable because they
# were derived from one deployment's measured traffic (50-150 searches/day).
# KB_API__RATE_LIMITS__PER_MINUTE=60
# KB_API__RATE_LIMITS__DAILY_ANOMALY=600
# KB_API__RATE_LIMITS__DAILY_LIMIT=2000
# KB_API__LOG_LEVEL=INFO

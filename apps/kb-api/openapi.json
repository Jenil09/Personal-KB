      "DocumentStatus": {
        "description": "Where a document is in the two-store write (AD-003).\n\n`PENDING` is not a queue state \u2014 it means Postgres has the document and\nChroma may not, and the startup reconciliation pass exists to close that\nwindow.",
        "enum": [
          "pending",
          "indexed",
          "failed"
        ],
        "title": "DocumentStatus",
        "type": "string"
      },
      "DocumentSummary": {
        "description": "A document as it appears in a listing \u2014 everything but the content.\n\n`content` is deliberately absent. The corpus averages ~0.5 MB a file, so a\nfifty-item page carrying content would be a 25 MB response to a request that\nasked \"what is in here\"; PRD \u00a76.5 is the endpoint that returns content, one\ndocument at a time.",
        "examples": [
          {
            "chunk_count": 14,
            "collection": "kb__openai__text_embedding_3_small__1536__c1",
            "content_hash": "9f2c...",
            "created_at": "2026-07-30T09:12:44Z",

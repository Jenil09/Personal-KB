      "SearchFiltersRequest": {
        "additionalProperties": false,
        "description": "PRD \u00a76.2's `filters`.\n\n`extra=\"forbid\"`, unlike every other model here. A misspelled filter key is\nthe one validation failure that would otherwise be invisible: the request\nsucceeds, the filter silently does not apply, and the caller gets a larger\nresult set that looks entirely plausible. Being wrong quietly is worse than\na `422` naming the key.",
        "properties": {
          "match_all_tags": {
            "default": false,
            "description": "Require every tag rather than any of them.",
            "title": "Match All Tags",
            "type": "boolean"
          },
          "source": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "tags": {
            "default": [],
            "description": "Matches documents carrying any of these tags. Resolved through PostgreSQL, not Chroma metadata (AD-005).",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "type": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "title": "SearchFiltersRequest",
        "type": "object"
      },
      "SearchRequest": {
        "examples": [
          {
            "filters": {
              "tags": [
                "ansible"
              ],
              "type": "architecture"
            },
            "provider": "openai",
            "query": "bare metal kubernetes with cilium and longhorn",
            "top_k": 5

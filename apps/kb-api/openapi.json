  "info": {
    "title": "kb-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Healthy, or degraded but still serving"
          },
          "503": {
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Liveness and dependency health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/admin/stats": {
      "get": {
        "operationId": "service_stats_v1_admin_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            },
            "description": "Counts, collections, and observability health"
          },
          "401": {
            "description": "Missing or unrecognised API key"
          },
          "403": {
            "description": "The key lacks the `write` scope (AD-024)"
          },
          "429": {
            "description": "Rate limit exceeded (AD-014)"
          }
        },
        "security": [
          {
            "API key": []
          }
        ],
        "summary": "Service and corpus statistics",
        "tags": [
          "admin"
        ]

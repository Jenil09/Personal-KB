      "DocumentListResponse": {
        "description": "One page of PRD \u00a76.4.\n\n`total` is the count matching the filters, not the page size \u2014 a client\npaginating needs to know when to stop, and deriving that from a short page\nbreaks when the last page happens to be full.",
        "examples": [
          {
            "documents": [],
            "limit": 50,
            "offset": 0,
            "total": 24
          }
        ],
        "properties": {
          "documents": {

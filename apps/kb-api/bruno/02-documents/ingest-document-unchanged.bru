meta {
  name: ingest document (unchanged)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/documents
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Redshift Architecture",
    "content": "# Redshift Architecture\n\n## Networking\n\nBare metal Kubernetes with Cilium in kube-proxy replacement mode. BGP peering to the top-of-rack switch advertises LoadBalancer addresses.\n\n## Storage\n\nLonghorn with three replicas per volume, backed by NVMe. Snapshots ship nightly to object storage.\n",
    "source": "redshift_architecture.md",
    "type": "architecture",
    "tags": ["ansible", "hardening"],
    "provider": "openai"
  }
}

docs {
  Byte-identical to the request before it. AD-008's short-circuit means this
  costs zero embedding calls and zero tokens, and returns the id the first
  ingest created. Run it immediately after `ingest document`.
}

assert {
  res.status: eq 201
  res.body.status: eq unchanged
  res.body.total_tokens: eq 0
  res.body.document_id: eq {{document_id}}
}

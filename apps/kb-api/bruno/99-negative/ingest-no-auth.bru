meta {
  name: ingest without a key
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/documents
  body: json
  auth: none
}

body:json {
  {
    "title": "Unauthorised",
    "content": "This should never be indexed.",
    "type": "architecture"
  }
}

docs {
  AD-011: every 401 is the same 401. A missing header, a malformed one, and an
  unrecognised key all answer `unauthenticated`, so a rejection cannot be used
  to probe which keys exist.
}

assert {
  res.status: eq 401
  res.body.code: eq unauthenticated
}

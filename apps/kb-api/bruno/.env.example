# Copy to .env in this folder. Never commit .env — it is gitignored.
#
# Two keys, because AD-024 gives them different scopes and the negative
# folder asserts the difference. KB_API_KEY is the operator key
# (search + write); KB_API_SEARCH_KEY is the n8n key (search only).
KB_API_KEY=change-me
KB_API_SEARCH_KEY=change-me-too
KB_API_BASE_URL=https://kb.example.com

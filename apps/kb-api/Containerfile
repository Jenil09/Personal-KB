# kb-api — one image, two runtimes (AD-022).
#
# Built with Podman locally and CI, with Docker on the VPS, from this file. It
# carries no rootless-Podman assumption: the container drops to a non-root user
# by explicit `USER` and a numeric UID, rather than relying on Podman's UID
# remapping to make root-in-container harmless. Under Docker it would not be.
#
# Two stages. The builder resolves the workspace into a virtualenv; the runtime
# carries that virtualenv and the source, and nothing else — no uv, no compiler,
# no lockfile.
#
# The dependency layer is separated from the source layer deliberately. Editing
# a router must not re-resolve and re-download ~80 wheels, so the first `uv sync`
# runs with only the pyproject files present and `--no-install-workspace`, which
# is the flag that matters in a workspace: `--no-install-project` would skip the
# root and still try to build the four members, defeating the cache.
#
# Migrations run from this same image as a separate command (see
# `compose.prod.yml`). `alembic` arrives via `platform-db`, so the runtime stage
# needs nothing extra to support it.

# --- builder ---------------------------------------------------------------

FROM python:3.13-slim-bookworm AS builder

# uv as a copied binary rather than as a base image, so both stages start from
# the same interpreter. A uv-provided Python in the builder and a Debian one in
# the runtime would mean the virtualenv was built against an interpreter the
# runtime does not have — which works until a package ships a compiled wheel.
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    # The virtualenv is built at the path it will be *used* at, not at the path
    # it is built at. Console scripts get an absolute shebang, so a venv created
    # under /build and copied to /app leaves `alembic` and `uvicorn` pointing at
    # /build/.venv/bin/python, which does not exist in the runtime stage — the
    # image imports fine and fails on `docker run` with "missing dynamic
    # library?". Only the entry points break, so `python -c "import kb_api"`
    # passes and the thing the CMD actually invokes does not.
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

# Layer one: dependencies only. Every workspace member's pyproject is needed for
# the resolution to succeed, but none of their sources are.
COPY pyproject.toml uv.lock .python-version ./
COPY apps/kb-api/pyproject.toml apps/kb-api/
COPY libs/ai-embeddings/pyproject.toml libs/ai-embeddings/
COPY libs/platform-core/pyproject.toml libs/platform-core/
COPY libs/platform-db/pyproject.toml libs/platform-db/
COPY libs/platform-fastapi/pyproject.toml libs/platform-fastapi/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package kb-api

# Layer two: the workspace itself. `--no-editable` so the members are copied into
# site-packages rather than linked back at /build, which does not exist in the
# runtime stage.
COPY apps/kb-api/src apps/kb-api/src
COPY libs/ai-embeddings/src libs/ai-embeddings/src
COPY libs/platform-core/src libs/platform-core/src
COPY libs/platform-db/src libs/platform-db/src
COPY libs/platform-fastapi/src libs/platform-fastapi/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package kb-api

# --- runtime ---------------------------------------------------------------

FROM python:3.13-slim-bookworm AS runtime

# A fixed UID, not just a name. The audit spill is a bind-mountable path and the
# host has to be able to reason about who owns it without inspecting the image.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app app

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv

# Alembic is invoked from this directory by the migration container. The
# migration tree is source, not a package, so it is copied rather than installed.
COPY --chown=10001:10001 apps/kb-api/alembic.ini apps/kb-api/alembic.ini
COPY --chown=10001:10001 apps/kb-api/migrations apps/kb-api/migrations

# AD-013's spill file. It must be writable by the runtime user, and it must
# survive a container replacement, so compose mounts a named volume here.
RUN mkdir -p /app/data && chown 10001:10001 /app/data

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    KB_API__AUDIT__SPILL_PATH=/app/data/audit.spill.jsonl

USER 10001:10001

EXPOSE 8000

# A single worker (Design §6). The query cache, the tier-2 queue, and the
# rate-limit buckets are each held once in this process; a second worker would
# fragment all three and multiply AD-014's thresholds by the worker count.
#
# `--factory`, because `build_app` reads the environment when it is called
# rather than at import (Phase 6).
CMD ["uvicorn", "kb_api.main:build_app", \
     "--factory", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--no-access-log"]

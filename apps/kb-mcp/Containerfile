# kb-mcp — one image, two runtimes (AD-022).
#
# Built with Podman locally and CI, with Docker on the VPS, from this file. It
# carries no rootless-Podman assumption: the container drops to a non-root user
# by explicit `USER` and a numeric UID, rather than relying on Podman's UID
# remapping to make root-in-container harmless. Under Docker it would not be.
#
# Two stages. The builder resolves the workspace into a virtualenv; the runtime
# carries that virtualenv and the source, and nothing else — no uv, no compiler,
# no lockfile. This image is an HTTP client of kb-api and never of Postgres or
# Chroma (AD-025), so there is no Alembic tree and no audit spill path.
#
# The dependency layer is separated from the source layer deliberately. Editing
# a tool must not re-resolve and re-download the wheels, so the first `uv sync`
# runs with only the pyproject files present and `--no-install-workspace`, which
# is the flag that matters in a workspace: `--no-install-project` would skip the
# root and still try to build the members, defeating the cache.
#
# `httpx2` (via `mcp`) validates TLS against the OS trust store, not certifi.
# The runtime stage therefore installs `ca-certificates` rather than inheriting
# whatever slim happens to ship.

# --- builder ---------------------------------------------------------------

FROM python:3.13-slim-bookworm AS builder

# uv as a copied binary rather than as a base image, so both stages start from
# the same interpreter. A uv-provided Python in the builder and a Debian one in
# the runtime would mean the virtualenv was built against an interpreter the
# runtime does not have — which works until a package ships a compiled wheel.
COPY --from=ghcr.io/astral-sh/uv:0.12.0 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    # The virtualenv is built at the path it will be *used* at, not at the path
    # it is built at. Console scripts get an absolute shebang, so a venv created
    # under /build and copied to /app leaves `python -m kb_mcp` pointing at
    # /build/.venv/bin/python, which does not exist in the runtime stage — the
    # image imports fine and fails on `docker run` with "missing dynamic
    # library?". Only the entry points break, so `python -c "import kb_mcp"`
    # passes and the thing the CMD actually invokes does not.
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

# Layer one: dependencies only. Every workspace member's pyproject is needed
# for the lockfile's workspace glob to match the builder; none of their sources
# are. Only kb-mcp / kb-client / platform-core are installed in layer two.
COPY pyproject.toml uv.lock .python-version ./
COPY apps/kb-api/pyproject.toml apps/kb-api/
COPY apps/kb-mcp/pyproject.toml apps/kb-mcp/
COPY libs/ai-embeddings/pyproject.toml libs/ai-embeddings/
COPY libs/kb-client/pyproject.toml libs/kb-client/
COPY libs/platform-core/pyproject.toml libs/platform-core/
COPY libs/platform-db/pyproject.toml libs/platform-db/
COPY libs/platform-fastapi/pyproject.toml libs/platform-fastapi/
COPY tools/kb-cli/pyproject.toml tools/kb-cli/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace --package kb-mcp

# Layer two: the workspace itself. `--no-editable` so the members are copied into
# site-packages rather than linked back at /build, which does not exist in the
# runtime stage.
COPY apps/kb-mcp/src apps/kb-mcp/src
COPY libs/kb-client/src libs/kb-client/src
COPY libs/platform-core/src libs/platform-core/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package kb-mcp

# --- runtime ---------------------------------------------------------------

FROM python:3.13-slim-bookworm AS runtime

# A fixed UID, not just a name. Same uid as kb-api so the two images reason
# about ownership the same way on the host.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /app app \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:10001

EXPOSE 9000

# `python -m kb_mcp` rather than a uvicorn factory line: `__main__` turns a
# missing secret into the sentence that names the variable, which is what an
# operator reading a container's first ten lines should see. One worker is
# hard-coded there — the session manager holds transport state in process
# memory, so a second worker would answer requests for sessions it has never
# heard of.
CMD ["python", "-m", "kb_mcp"]
